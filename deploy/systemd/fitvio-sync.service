[Unit]
Description=Fitvio: GarminDB download + ingest + verdicts
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__ROOT__
Environment=FITVIO_CONFIG=__ROOT__/config/users.json
ExecStart=__ROOT__/.venv/bin/fitvio sync
TimeoutStartSec=45min
Nice=10
